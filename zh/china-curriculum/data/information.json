  "items": [
    {
      "uid": "in-all-con-76682c1b",
      "seq": 1,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "全学段",
      "stage_key": "all",
      "domain": "课程内容",
      "topic": "content",
      "type": "content",
      "text": "数据：数据来源的可靠性一数据的组织与呈现一数据对现代社会的重要意义。",
      "source_page": 12,
      "source_pdf_page": 19,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-all-con-6557aa1a",
      "seq": 2,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "全学段",
      "stage_key": "all",
      "domain": "课程内容",
      "topic": "content",
      "type": "content",
      "text": "算法：问题的步骤分解一算法的描述、执行与效率一解决问题的策略或方法。",
      "source_page": 12,
      "source_pdf_page": 19,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-all-con-d584887e",
      "seq": 3,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "全学段",
      "stage_key": "all",
      "domain": "课程内容",
      "topic": "content",
      "type": "content",
      "text": "网络：网络搜索与辅助协作学习一数字化成果分享一万物互联的途径、原理和意义。",
      "source_page": 12,
      "source_pdf_page": 19,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-all-con-894b9245",
      "seq": 4,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "全学段",
      "stage_key": "all",
      "domain": "课程内容",
      "topic": "content",
      "type": "content",
      "text": "信息处理：文字、图片、音频和视频等信息处理一使用编码建立数据间内在联系的原则与方法一基于物联网生成、处理数据的流程和特点。",
      "source_page": 12,
      "source_pdf_page": 19,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-all-con-a5617493",
      "seq": 5,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "全学段",
      "stage_key": "all",
      "domain": "课程内容",
      "topic": "content",
      "type": "content",
      "text": "信息安全：文明礼仪、行为规范、依法依规、个人隐私保护一规避风险原则、安全观一防范措施、风险评估。",
      "source_page": 12,
      "source_pdf_page": 19,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-all-con-e2edc1a4",
      "seq": 6,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "全学段",
      "stage_key": "all",
      "domain": "课程内容",
      "topic": "content",
      "type": "content",
      "text": "人工智能：应用系统体验一机器计算与人工计算的异同一伦理与安全挑战。如图1所示，具体学习内容由内容模块和跨学科主题两部分组",
      "source_page": 12,
      "source_pdf_page": 19,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x1-con-6561ba09",
      "seq": 7,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学低段（1-2年级）",
      "stage_key": "x1",
      "domain": "信息交流与分享",
      "topic": "content",
      "type": "content",
      "text": "在日常学习与生活场景中，通过教师指导，尝试使用数字设备与数字资源开展识字、朗读和阅读等活动，扩充语言学习的手段与方法。",
      "source_page": 14,
      "source_pdf_page": 21,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x1-con-027b41fd",
      "seq": 8,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学低段（1-2年级）",
      "stage_key": "x1",
      "domain": "信息交流与分享",
      "topic": "content",
      "type": "content",
      "text": "在家庭、校园、公园等场景中，体验、感受与智能语音助手、电子导览等数字设备的交互过程。",
      "source_page": 14,
      "source_pdf_page": 21,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x1-con-051f1ebf",
      "seq": 10,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学低段（1-2年级）",
      "stage_key": "x1",
      "domain": "信息交流与分享",
      "topic": "content",
      "type": "content",
      "text": "在浏览他人数字作品时，能主动、真诚、友善地发表评论，用恰当的数学化方式加以表达，如“点费”等。",
      "source_page": 14,
      "source_pdf_page": 21,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x1-con-a7186ef7",
      "seq": 11,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学低段（1-2年级）",
      "stage_key": "x1",
      "domain": "信息交流与分享",
      "topic": "content",
      "type": "content",
      "text": "通过数字设备辅助学习、交流与分享，激发对信息科技的好奇心和学习兴趣，产生对信息科技的求知欲。",
      "source_page": 14,
      "source_pdf_page": 21,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x1-con-1322ccbd",
      "seq": 12,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学低段（1-2年级）",
      "stage_key": "x1",
      "domain": "信息交流与分享",
      "topic": "content",
      "type": "content",
      "text": "在学习与生活中，能用正确的姿势使用数学设备，养成好习惯，注意保护视力。",
      "source_page": 15,
      "source_pdf_page": 22,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x1-con-142a3bf4",
      "seq": 16,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学低段（1-2年级）",
      "stage_key": "x1",
      "domain": "信息隐私与安全",
      "topic": "content",
      "type": "content",
      "text": "在各种在线活动中，能在教师指导下辨别信息真伪，知道个人信息保护的重要性，养成保护个人信息的好习惯。",
      "source_page": 17,
      "source_pdf_page": 24,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x1-con-9adf5968",
      "seq": 17,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学低段（1-2年级）",
      "stage_key": "x1",
      "domain": "信息隐私与安全",
      "topic": "content",
      "type": "content",
      "text": "能对数字设备记录的文字、图片、音频、视频等信息进行分类、保存与提取。",
      "source_page": 17,
      "source_pdf_page": 24,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x1-con-5a14bd73",
      "seq": 18,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学低段（1-2年级）",
      "stage_key": "x1",
      "domain": "信息隐私与安全",
      "topic": "content",
      "type": "content",
      "text": "能在分享他人数字作品时标注来源，尊重数字作品所有者的权益。",
      "source_page": 17,
      "source_pdf_page": 24,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x1-con-94bee442",
      "seq": 19,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学低段（1-2年级）",
      "stage_key": "x1",
      "domain": "信息隐私与安全",
      "topic": "content",
      "type": "content",
      "text": "合理安排数字设备的使用时间，了解健康使用数字设备的重要性。",
      "source_page": 17,
      "source_pdf_page": 24,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x1-con-eee4f01b",
      "seq": 20,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学低段（1-2年级）",
      "stage_key": "x1",
      "domain": "信息隐私与安全",
      "topic": "content",
      "type": "content",
      "text": "在线交流时，了解在网络空间也要遵守日常行为规范。",
      "source_page": 17,
      "source_pdf_page": 24,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x2-con-659a2e51",
      "seq": 29,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学中段（3-4年级）",
      "stage_key": "x2",
      "domain": "在线学习与生活",
      "topic": "content",
      "type": "content",
      "text": "结合学习需要，能将问题进行分解，并用文字或图示描述解决问题的顺序，利用在线方式分派任务、交流讨论、表达观点、发布成果，在解决问题的过程中体验协作带来的效率提升。",
      "source_page": 21,
      "source_pdf_page": 28,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x2-con-235401d1",
      "seq": 32,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学中段（3-4年级）",
      "stage_key": "x2",
      "domain": "在线学习与生活",
      "topic": "content",
      "type": "content",
      "text": "了解自主可控技术对在线行为的影响，初步形成在线社会的安全观。",
      "source_page": 21,
      "source_pdf_page": 28,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x2-con-47a612fa",
      "seq": 38,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学中段（3-4年级）",
      "stage_key": "x2",
      "domain": "数据与编码",
      "topic": "content",
      "type": "content",
      "text": "结合真实情境，了解编码在生活中的应用，认识数据编码的目的，理解数据编码是保持信息社会组织与秩序的科学基础。",
      "source_page": 24,
      "source_pdf_page": 31,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x2-con-16ade4dd",
      "seq": 39,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学中段（3-4年级）",
      "stage_key": "x2",
      "domain": "数据与编码",
      "topic": "content",
      "type": "content",
      "text": "通过观察身边的真实案例，知道如何使用编码建立数据间的内在联系，以便计算机识别和管理，了解编码长度与所包含信息量之间的关系。",
      "source_page": 24,
      "source_pdf_page": 31,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x2-con-88bb366f",
      "seq": 41,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学中段（3-4年级）",
      "stage_key": "x2",
      "domain": "数据与编码",
      "topic": "content",
      "type": "content",
      "text": "通过真实案例了解威胁数据安全的因素，认识自主可控技术对数据安全的影响，在学习和生活中有意识地保护数据，并遵守相关的法律法规。",
      "source_page": 24,
      "source_pdf_page": 31,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x2-con-4fae931e",
      "seq": 42,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学中段（3-4年级）",
      "stage_key": "x2",
      "domain": "数据与编码",
      "topic": "content",
      "type": "content",
      "text": "在对简单问题的分析过程中，使用数字化工具组织并呈现收集的数据，借助可视化方式表示数据之间的关系以支撑自己的观点。",
      "source_page": 24,
      "source_pdf_page": 31,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x2-con-3f63763e",
      "seq": 43,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学中段（3-4年级）",
      "stage_key": "x2",
      "domain": "数据与编码",
      "topic": "content",
      "type": "content",
      "text": "在学习与生活中，能用数据记录并描述规律性发生的事件，简单地表达自己的想法或预测结果。",
      "source_page": 24,
      "source_pdf_page": 31,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x3-con-2478eed8",
      "seq": 48,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学高段（5-6年级）",
      "stage_key": "x3",
      "domain": "身边的算法",
      "topic": "content",
      "type": "content",
      "text": "借助学习与生活中的实例，体验身边的算法，理解算法是通过明确的、可执行的操作步骤描述的问题求解方案，能用自然语言、流程图等方式描述算法。",
      "source_page": 28,
      "source_pdf_page": 35,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x3-con-1d5bf951",
      "seq": 49,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学高段（5-6年级）",
      "stage_key": "x3",
      "domain": "身边的算法",
      "topic": "content",
      "type": "content",
      "text": "结合生活中的实例，了解算法的顺序、分支和循环三种基本控制结构，能分析简单算法的执行过程与结果。",
      "source_page": 28,
      "source_pdf_page": 35,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x3-con-fd3558b8",
      "seq": 50,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学高段（5-6年级）",
      "stage_key": "x3",
      "domain": "身边的算法",
      "topic": "content",
      "type": "content",
      "text": "通过真实案例，知道算法步骤的执行次数与问题的规模有关，观察并体验采用不同算法解决同一问题时在时间效率上的差别。",
      "source_page": 28,
      "source_pdf_page": 35,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x3-con-7e701179",
      "seq": 51,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学高段（5-6年级）",
      "stage_key": "x3",
      "domain": "身边的算法",
      "topic": "content",
      "type": "content",
      "text": "针对简单问题，尝试设计求解算法，并通过程序进行验证。",
      "source_page": 28,
      "source_pdf_page": 35,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x3-con-47b1d2cd",
      "seq": 52,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学高段（5-6年级）",
      "stage_key": "x3",
      "domain": "身边的算法",
      "topic": "content",
      "type": "content",
      "text": "以信息社会日常活动中蕴含的算法为例，讨论在线生活中算法的价值与局限（包括算法对知识产权保护的作用等），及算法对生活的指导意义。",
      "source_page": 28,
      "source_pdf_page": 35,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x3-con-0b01854e",
      "seq": 59,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学高段（5-6年级）",
      "stage_key": "x3",
      "domain": "过程与控制",
      "topic": "content",
      "type": "content",
      "text": "通过分析典型应用场景，了解计算机可用于实现过程与控制，能在实验系统中通过编程等手段验证过程与控制系统的设计。",
      "source_page": 30,
      "source_pdf_page": 37,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-x3-con-888c96ed",
      "seq": 60,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "小学高段（5-6年级）",
      "stage_key": "x3",
      "domain": "过程与控制",
      "topic": "content",
      "type": "content",
      "text": "结合生活中的实例，理解过程与控制系统中存在安全问题，知道自主可控的系统在解决安全问题时起到的重要作用。",
      "source_page": 31,
      "source_pdf_page": 38,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-j1-con-908b0bdc",
      "seq": 65,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "初中（7-9年级）",
      "stage_key": "j1",
      "domain": "互联网应用与创新",
      "topic": "content",
      "type": "content",
      "text": "通过在线活动，分析互联网应用的特征，认识到互联网对社会发展的创新价值和潜力。",
      "source_page": 34,
      "source_pdf_page": 41,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-j1-con-86a36612",
      "seq": 66,
      "subject": "信息科技",
      "subject_key": "information",
      "stage": "初中（7-9年级）",
      "stage_key": "j1",
      "domain": "互联网应用与创新",
      "topic": "content",
      "type": "content",
      "text": "能够根据学习和交流的需要，使用互联网搜索、选、管理并贡献有价值的数据和资源，能够创建具有特色的作品。",
      "source_page": 35,
      "source_pdf_page": 42,
      "source_id": "moe-cn-2022-information"
    },
    {
      "uid": "in-j1-con-d65391c8",
