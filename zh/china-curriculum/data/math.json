      "stage": "小学高段（5-6年级）",
      "stage_key": "x3",
      "domain": "数与代数",
      "topic": "数量关系",
      "type": "content",
      "text": "通过具体情境，认识成正比的量（如=5）（例20)；能探索规律或变化趋势（如y=5α）（例21)。",
      "source_page": 24,
      "source_pdf_page": 31,
      "source_id": "moe-cn-2022-math"
    },
    {
      "uid": "ma-x3-con-cda3695b",
