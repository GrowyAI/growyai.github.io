      "stage_key": "j1",
      "domain": "课程内容",
      "topic": "content",
      "type": "content",
      "text": "日语课程内容六要素的相互关系如图1所示。语篇文化理解语言知识语言技能图1",
      "source_page": 8,
      "source_pdf_page": 15,
      "source_id": "moe-cn-2022-japanese"
    },
