      "subject_key": "biology",
      "stage": "初中（7-9年级）",
      "stage_key": "j1",
      "domain": "生物的多样性",
      "topic": "教学策略建议",
      "type": "content",
      "text": "充分利用本地的生物资源，组织学生识别生物的特征，尝试开展分类活动。",
      "source_page": 13,
      "source_pdf_page": 20,
      "source_id": "moe-cn-2022-biology"
    },
    {
